# =============================================================================
# FinançaApp - Exemplo de Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# =============================================================================

# Banco de Dados PostgreSQL
DATABASE_URL="postgresql://financa_user:financa_pass@localhost:5432/financa_db?schema=public"

# Next.js
NEXT_PUBLIC_APP_NAME="FinançaApp"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Pluggy (Open Finance)
PLUGGY_CLIENT_ID="sua_client_id_aqui"
PLUGGY_CLIENT_SECRET="sua_client_secret_aqui"
